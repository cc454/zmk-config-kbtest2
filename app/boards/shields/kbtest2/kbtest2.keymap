#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        swiss_german {
            // Windows Swiss German maps the HID Y position to Z.
            bindings = <
                &kp C_MUTE  &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6
                &kp PRINTSCREEN  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &none
                &kp PG_UP  &kp CAPSLOCK  &kp A  &kp S  &kp D  &kp F  &kp G  &none
                &kp PG_DN  &kp LSHIFT  &kp NON_US_BACKSLASH  &kp Y  &kp X  &kp C  &kp V  &kp B
                &kp C_AL_CALCULATOR  &kp LCTRL  &mo 1  &kp LGUI  &kp LALT  &kp SPACE  &none  &none

                &none  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp BSPC  &kp DEL
                &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp ENTER
                &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp APOS  &kp BACKSLASH  &none
                &kp N  &kp M  &kp COMMA  &kp DOT  &none  &kp RSHIFT  &kp UP  &kp SLASH
                &none  &none  &kp SPACE  &kp RALT  &mo 1  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &none
                &trans &trans &trans &trans &trans &trans &trans &none
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &none &none

                &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
                &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans
                &none  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
